<Window x:Class="CmdletForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:CmdletForge.Controls"
        Title="Cmdlet Forge" Width="1360" Height="860" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Menu Grid.Row="0">
      <MenuItem Header="_Bestand">
        <MenuItem Header="_Nieuw" InputGestureText="Ctrl+N" Click="NewFile_Click" />
        <MenuItem Header="_Openen..." InputGestureText="Ctrl+O" Click="OpenFile_Click" />
        <MenuItem Header="_Opslaan" InputGestureText="Ctrl+S" Click="SaveFile_Click" />
        <MenuItem Header="Opslaan _als..." InputGestureText="Ctrl+Shift+S" Click="SaveAsFile_Click" />
        <Separator />
        <MenuItem x:Name="RecentFilesMenu" Header="_Recent" />
        <Separator />
        <MenuItem Header="_Afsluiten" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Bewerken">
        <MenuItem Header="_Ongedaan maken" InputGestureText="Ctrl+Z" Click="Undo_Click" />
        <MenuItem Header="Opnieuw" InputGestureText="Ctrl+Y" Click="Redo_Click" />
        <Separator />
        <MenuItem Header="_Zoeken" InputGestureText="Ctrl+F" Click="ShowFind_Click" />
        <MenuItem Header="Zoeken en _vervangen" InputGestureText="Ctrl+H" Click="ShowReplace_Click" />
        <MenuItem Header="_Spring naar..." InputGestureText="Ctrl+G" Click="FocusGoTo_Click" />
        <Separator />
        <MenuItem Header="Alles selecteren" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
      </MenuItem>
      <MenuItem Header="_Uitvoeren">
        <MenuItem Header="Selectie uitvoeren" InputGestureText="Ctrl+Enter" Click="RunSelection_Click" />
        <MenuItem Header="Script uitvoeren" InputGestureText="F5" Click="RunScript_Click" />
        <MenuItem Header="Script uitvoeren met _parameters..." InputGestureText="Ctrl+F5" Click="RunScriptWithParameters_Click" />
        <MenuItem Header="Opdracht stoppen en terminal herstarten" InputGestureText="Shift+F5" Click="RestartTerminal_Click" />
      </MenuItem>
      <MenuItem Header="_Beheer">
        <MenuItem Header="PowerShell-modules..." Click="ManageModules_Click" />
        <MenuItem Header="Updates..." Click="ManageUpdates_Click" />
        <MenuItem Header="Logmap openen" Click="OpenLogs_Click" />
      </MenuItem>
      <MenuItem Header="_Beeld">
        <MenuItem x:Name="DarkModeMenu" Header="Donkere modus" IsCheckable="True" Click="DarkModeMenu_Click" />
        <MenuItem x:Name="WordWrapMenu" Header="Regelterugloop" IsCheckable="True" Click="WordWrapMenu_Click" />
        <MenuItem x:Name="CrtMenu" Header="CRT-scanlines" IsCheckable="True" Click="CrtMenu_Click" />
        <Separator />
        <MenuItem Header="Alle blokken _inklappen" Click="CollapseAllFoldings_Click" />
        <MenuItem Header="Alle blokken _uitklappen" Click="ExpandAllFoldings_Click" />
        <Separator />
        <MenuItem Header="Terminal wissen" Click="ClearTerminal_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Over Cmdlet Forge" Click="About_Click" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Openen" ToolTip="PowerShell-script openen (Ctrl+O)" Click="OpenFile_Click" />
          <Button Content="Opslaan" Margin="6,0,0,0" ToolTip="Script opslaan (Ctrl+S)" Click="SaveFile_Click" />
          <Button Content="▶ Selectie" Margin="16,0,0,0" ToolTip="Selectie uitvoeren (Ctrl+Enter)" Click="RunSelection_Click" />
          <Button Content="▶ Script" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" ToolTip="Hele script uitvoeren (F5)" Click="RunScript_Click" />
          <Button Content="▶ Parameters..." Margin="6,0,0,0" ToolTip="Script uitvoeren met gedetecteerde parameters (Ctrl+F5)" Click="RunScriptWithParameters_Click" />
          <Button Content="■ Stop" Margin="6,0,0,0" ToolTip="Actieve PowerShell stoppen en terminal herstarten" Click="RestartTerminal_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock Text="Thema" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
          <ComboBox x:Name="ThemeCombo" Width="92" SelectionChanged="ThemeCombo_SelectionChanged">
            <ComboBoxItem Content="Donker" Tag="Dark" />
            <ComboBoxItem Content="Licht" Tag="Light" />
          </ComboBox>
          <TextBlock Text="Schema" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,6,0" />
          <ComboBox x:Name="PaletteCombo" Width="126" SelectionChanged="PaletteCombo_SelectionChanged">
            <ComboBoxItem Content="Forge" Tag="Forge" />
            <ComboBoxItem Content="Oceanic" Tag="Oceanic" />
            <ComboBoxItem Content="Hoog contrast" Tag="HighContrast" />
          </ComboBox>
          <TextBlock Text="Regel" Foreground="{DynamicResource TextMutedBrush}" Margin="16,0,6,0" />
          <TextBox x:Name="GoToLineBox" Width="56" Text="1" PreviewKeyDown="GoToBox_PreviewKeyDown" />
          <TextBlock Text="Teken" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,6,0" />
          <TextBox x:Name="GoToColumnBox" Width="56" Text="1" PreviewKeyDown="GoToBox_PreviewKeyDown" />
          <Button Content="Spring" Margin="6,0,0,0" Click="GoTo_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="SearchPanel" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8" Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" ToolTip="Zoeken sluiten (Esc)" Margin="8,0,0,0" Click="CloseSearch_Click" />
        <WrapPanel>
          <TextBlock Text="Zoeken" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
          <TextBox x:Name="FindBox" Width="240" TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown" />
          <Button Content="Vorige" Margin="6,0,0,0" Click="FindPrevious_Click" />
          <Button Content="Volgende" Margin="6,0,0,0" Click="FindNext_Click" />
          <CheckBox x:Name="MatchCaseCheck" Content="Aa" Margin="12,0,0,0" ToolTip="Hoofdlettergevoelig" />
          <CheckBox x:Name="WholeWordCheck" Content="Woord" Margin="10,0,0,0" />
          <CheckBox x:Name="RegexCheck" Content="Regex" Margin="10,0,0,0" />
          <TextBlock x:Name="FindStatus" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0" />
          <StackPanel x:Name="ReplaceControls" Orientation="Horizontal" Margin="18,0,0,0" Visibility="Collapsed">
            <TextBlock Text="Vervangen" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
            <TextBox x:Name="ReplaceBox" Width="220" />
            <Button Content="Vervang" Margin="6,0,0,0" Click="ReplaceOne_Click" />
            <Button Content="Alles" Margin="6,0,0,0" Click="ReplaceAll_Click" />
          </StackPanel>
        </WrapPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="180" />
        <RowDefinition Height="5" />
        <RowDefinition Height="2*" MinHeight="160" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <avalon:TextEditor x:Name="Editor" FontFamily="{StaticResource MonoFont}" FontSize="14"
                           ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown" />
      </Border>

      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

      <TabControl Grid.Row="2" x:Name="BottomTabs" BorderThickness="0">
        <TabItem Header="TERMINAL">
          <Grid Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RichTextBox x:Name="TerminalOutput" Grid.Row="0" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" Padding="10,8" />
            <controls:ScanlineOverlay x:Name="CrtOverlay" Grid.Row="0"
                                      ScanlineBrush="{DynamicResource CrtScanlineBrush}"
                                      PhosphorBrush="{DynamicResource CrtPhosphorBrush}" />
            <DockPanel Grid.Row="1" LastChildFill="True" Margin="8,4,8,8">
              <TextBlock DockPanel.Dock="Left" Text="PS&gt;" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,0,8,0" />
              <Button DockPanel.Dock="Right" Content="Uitvoeren" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="TerminalRun_Click" />
              <TextBox x:Name="TerminalInput" FontFamily="{StaticResource MonoFont}" PreviewKeyDown="TerminalInput_PreviewKeyDown" />
            </DockPanel>
          </Grid>
        </TabItem>
        <TabItem x:Name="ProblemsTab" Header="PROBLEMEN">
          <Grid Background="{DynamicResource SurfaceBrush}">
            <ListBox x:Name="ProblemsList" MouseDoubleClick="ProblemsList_MouseDoubleClick" BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Message}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <Border Width="3" Background="{DynamicResource DangerBrush}" Margin="0,1,6,1" />
                      <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextTrimming="CharacterEllipsis" Margin="6,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Location}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Geen problemen gevonden. Syntax- en uitvoerfouten verschijnen hier."
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=ProblemsList, Path=HasItems}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <StatusBar Grid.Row="4">
      <StatusBarItem><TextBlock x:Name="FileStatus" Text="Naamloos.ps1" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="SyntaxStatus" Text="Syntax: in orde" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="CaretStatus" Text="Regel 1, teken 1" /></StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="PowerShellStatus" Text="PowerShell: starten..." /></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
