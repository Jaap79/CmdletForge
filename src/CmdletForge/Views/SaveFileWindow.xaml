<Window x:Class="CmdletForge.Views.SaveFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="PowerShell-script opslaan" Width="860" Height="570" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Omhoog" Click="Up_Click" automation:AutomationProperties.HelpText="Ga naar de bovenliggende map" />
      <TextBox x:Name="DirectoryBox" Grid.Column="2" VerticalContentAlignment="Center" PreviewKeyDown="DirectoryBox_PreviewKeyDown"
               automation:AutomationProperties.Name="Huidige map" />
      <Button Grid.Column="4" Content="Ga" Click="Go_Click" />
      <Button Grid.Column="6" Content="Vernieuwen" Click="Refresh_Click" />
      <Button Grid.Column="8" Content="Nieuwe map" Click="NewFolder_Click" />
    </Grid>

    <Grid Grid.Row="2">
      <ListView x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged" MouseDoubleClick="EntriesList_MouseDoubleClick"
                automation:AutomationProperties.Name="Mappen en bestanden">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Naam" Width="360" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Type}" />
            <GridViewColumn Header="Gewijzigd" Width="150" DisplayMemberBinding="{Binding Modified}" />
            <GridViewColumn Header="Grootte" Width="100" DisplayMemberBinding="{Binding Size}" />
          </GridView>
        </ListView.View>
      </ListView>

      <Border x:Name="EmptyPanel" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock Text="Deze map bevat geen passende bestanden." Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="240" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Bestandsnaam" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBox x:Name="FileNameBox" Grid.Column="1" PreviewKeyDown="FileNameBox_PreviewKeyDown"
                   automation:AutomationProperties.Name="Bestandsnaam" />
          <TextBlock Grid.Column="3" Text="Bestandstype" Foreground="{DynamicResource TextMutedBrush}" />
          <ComboBox x:Name="FileTypeCombo" Grid.Column="4" SelectionChanged="FileTypeCombo_SelectionChanged"
                    automation:AutomationProperties.Name="Bestandstype" />
        </Grid>

        <Grid Grid.Row="4">
          <StackPanel x:Name="NewFolderPanel" Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Left">
            <TextBox x:Name="NewFolderBox" Width="260" PreviewKeyDown="NewFolderBox_PreviewKeyDown"
                     automation:AutomationProperties.Name="Naam van nieuwe map" />
            <Button Content="Aanmaken" Margin="8,0,0,0" Click="CreateFolder_Click" />
            <Button Content="Annuleren" Margin="6,0,0,0" Click="CancelNewFolder_Click" />
          </StackPanel>

          <StackPanel x:Name="SaveButtons" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" MinWidth="100" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Opslaan" MinWidth="100" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" />
          </StackPanel>

          <StackPanel x:Name="OverwriteButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
            <TextBlock x:Name="OverwriteText" Margin="0,0,14,0" Foreground="{DynamicResource WarningBrush}" />
            <Button Content="Terug" MinWidth="90" Click="CancelOverwrite_Click" />
            <Button Content="Overschrijven" MinWidth="120" Margin="8,0,0,0" Click="ConfirmOverwrite_Click"
                    Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
