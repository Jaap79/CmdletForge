<Window x:Class="CmdletForge.Views.ScriptParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script uitvoeren met parameters — beta" Width="820" Height="690" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7,3">
        <TextBlock Text="BETA" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
      </Border>
      <StackPanel>
        <TextBlock Text="SCRIPT UITVOEREN MET PARAMETERS" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="16" />
        <TextBlock x:Name="DocumentText" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
        <Run FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}">Let op: </Run>
        <Run Text="het script draait niet-geëlevateerd in een apart pwsh-proces, maar niet in een security-sandbox. Parameterwaarden worden als JSON-data via de gebruikers-tempmap doorgegeven en niet in terminal of log getoond. Gebruik deze beta niet voor wachtwoorden, tokens of credentials." />
      </TextBlock>
    </Border>

    <TextBlock Grid.Row="2" Text="Gedetecteerd uit het param(...) blok. Alleen aangevinkte parameters worden meegegeven; PowerShell valideert de invoer tijdens uitvoering." Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ParameterList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name, StringFormat=-{0}}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" Margin="8,0,0,0" Padding="5,1">
                      <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding DefaultSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <CheckBox Content="Parameter meegeven" IsChecked="{Binding Include}" IsEnabled="{Binding CanToggleInclude}" Margin="0,0,0,6" />
                  <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Include}"
                           Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Include}"
                           Visibility="{Binding ShowArray, Converter={StaticResource BoolToVisibility}}"
                           AcceptsReturn="True" Height="68" VerticalScrollBarVisibility="Auto" ToolTip="Eén arraywaarde per regel" />
                  <CheckBox Content="$true (uit = $false)" IsChecked="{Binding BooleanValue}" IsEnabled="{Binding Include}"
                            Visibility="{Binding ShowBoolean, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="De switch wordt als $true meegegeven." Foreground="{DynamicResource TextMutedBrush}"
                             Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="{Binding UnsupportedReason}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                             Visibility="{Binding ShowUnsupported, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Annuleren" IsCancel="True" Margin="6,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Uitvoeren" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Run_Click" />
      <TextBlock x:Name="StatusText" Text="Controleer de waarden vóór uitvoering." Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>
